APP_NAME="ANBK Cerdas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://anbk.example.com
APP_DOMAIN=anbk.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stderr
LOG_LEVEL=info
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=anbk
DB_USERNAME=anbk
DB_PASSWORD=change-this-database-password
POSTGRES_DB=anbk
POSTGRES_USER=anbk
POSTGRES_PASSWORD=change-this-database-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://account-id.r2.cloudflarestorage.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

AI_DRIVER=gemini
AI_DAILY_QUESTION_LIMIT=50
AI_DAILY_STORY_LIMIT=10
AI_DAILY_IMAGE_LIMIT=20
AI_DAILY_CHAT_LIMIT=20
AI_CHAT_CONTEXT_MESSAGES=12
AI_IMAGE_DISK=s3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_BATCH_COST_MICROUSD=16800
GEMINI_INPUT_USD_PER_MILLION=0.25
GEMINI_OUTPUT_USD_PER_MILLION=1.50

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@anbk.example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
